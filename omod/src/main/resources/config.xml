	</advice>
	 /AOP -->
	
	
	<privilege>
		<name>Get Metadata Export Packages</name>
		<description>Able to read metadata export packages and their builds</description>
	</privilege>
	<privilege>
		<name>Manage Metadata Export Packages</name>
		<description>Able to create, update and retire metadata export packages, trigger builds and download exports</description>
	</privilege>



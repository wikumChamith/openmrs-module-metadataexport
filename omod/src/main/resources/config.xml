<module configVersion="1.2">
	
	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>org.openmrs.module.metadataexport</package>
	<author>wikum</author>
	<description>
			${project.parent.description}
	</description>

	<activator>org.openmrs.module.metadataexport.MetadataExportActivator</activator>
	<!-- <updateURL>https://modules.openmrs.org/modules/download/@MODULE_ID@/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->
	
	<require_version>2.8.0</require_version>

	<require_modules>
		<require_module>org.openmrs.module.initializer</require_module>
	</require_modules>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
		<aware_of_module>org.openmrs.module.emrapi</aware_of_module>
		<aware_of_module>org.openmrs.module.fhir2</aware_of_module>
		<aware_of_module>org.openmrs.module.idgen</aware_of_module>
		<aware_of_module>org.openmrs.module.metadatamapping</aware_of_module>
		<aware_of_module>org.openmrs.module.metadatasharing</aware_of_module>
		<aware_of_module>org.openmrs.module.addresshierarchy</aware_of_module>
		<aware_of_module>org.openmrs.module.cohort</aware_of_module>
		<aware_of_module>org.openmrs.module.tasks</aware_of_module>
	</aware_of_modules>
	
	
	<!-- AOP

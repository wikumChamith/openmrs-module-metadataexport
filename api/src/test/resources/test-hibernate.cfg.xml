<!--
  Hibernate mappings of optional modules that map their entities with hbm.xml files instead of
  annotations. Core's session factory only scans org.openmrs for annotated classes, so without this
  the in-memory test schema has no tables for them. Loaded as an extra config location by the
  sessionFactory override in TestingApplicationContext.xml.
-->
<hibernate-configuration>
	<session-factory>
		<!-- Bahmni appointments (hbm files sit at the root of appointments-api.jar) -->
		<mapping resource="Speciality.hbm.xml"/>
		<mapping resource="AppointmentServiceDefinition.hbm.xml"/>
		<mapping resource="AppointmentServiceType.hbm.xml"/>
		<mapping resource="ServiceWeeklyAvailability.hbm.xml"/>
		<mapping resource="Appointment.hbm.xml"/>
		<mapping resource="AppointmentProvider.hbm.xml"/>
		<mapping resource="AppointmentAudit.hbm.xml"/>
		<mapping resource="AppointmentRecurringPattern.hbm.xml"/>
	</session-factory>
</hibernate-configuration>

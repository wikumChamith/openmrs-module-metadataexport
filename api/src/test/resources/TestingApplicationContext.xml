<!--
  Satisfies the only Initializer beans that its component scan cannot wire outside a started
  Initializer module, so the context-sensitive test can boot. Metadata export uses none of them.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<bean id="metadataExportStubAttributeTypesProxyService"
	      class="org.openmrs.module.metadataexport.StubAttributeTypesProxyService"/>

	<bean id="metadataExportStubAttributeTypeCsvLineHandler"
	      class="org.openmrs.module.metadataexport.StubAttributeTypeCsvLineHandler"/>

	<!--
	  Same definition as core's applicationContext-service.xml plus test-hibernate.cfg.xml, which
	  maps the hbm.xml-based entities of optional modules (Bahmni appointments) into the test schema.
	-->
	<bean id="sessionFactory" class="org.openmrs.api.db.hibernate.HibernateSessionFactoryBean">
		<property name="configLocations">
			<list>
				<value>classpath:hibernate.cfg.xml</value>
				<value>classpath:test-hibernate.cfg.xml</value>
			</list>
		</property>
		<property name="mappingJarLocations" ref="mappingJarResources"/>
		<property name="packagesToScan">
			<list>
				<value>org.openmrs</value>
			</list>
		</property>
	</bean>

</beans>
